# ---- 必填 ----
CHAT_JWT_SECRET=change-me-to-a-random-secret

# ---- 服务 ----
CHAT_ADDR=:8080
CHAT_DB_PATH=chat.db
CHAT_STATIC_DIR=../client/dist      # 相对 server/ 运行目录
CHAT_BASE_URL=                      # 绝对 URL 前缀（上传 url 等响应使用），生产必填

# ---- 上传 ----
CHAT_UPLOAD_DIR=uploads
CHAT_UPLOAD_SALT=                   # 未设置则随机生成（delete_url 校验，重启后旧链接失效）
CHAT_MAX_UPLOAD=20971520            # 20 MiB

# ---- JWT 时效 ----
CHAT_ACCESS_TTL=30m
CHAT_REFRESH_TTL=8760h

# ---- 超时 ----
CHAT_API_TIMEOUT=10s
CHAT_UPLOAD_TIMEOUT=5m
CHAT_READ_TIMEOUT=10m
CHAT_READ_HEADER_TIMEOUT=10s

# ---- 限制 ----
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_WS_MAX_MSG_SIZE=65536

# ---- 实时 ----
WS_ENABLED=false                     # 生产关闭 WebSocket（gateway.go 读取），仅剩 SSE/轮询

# ---- 安全 ----
CHAT_CSP_CONNECT_SRC="'self' wss://wsl-8080.moonchan.xyz"
CHAT_AI_ALLOW_PRIVATE=0             # 1 = 允许 AI 流式端点解析到内网地址（仅本地 ollama 等场景）
