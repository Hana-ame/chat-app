CHAT_JWT_SECRET=change-me-to-a-random-secret
CHAT_ACCESS_TTL=30m
CHAT_REFRESH_TTL=8760h
CHAT_ADDR=:8080
CHAT_DB_PATH=chat.db
CHAT_STATIC_DIR=../client/dist
CHAT_BASE_URL=
WS_ENABLED=false
# Single source (backward compatible)
CHAT_AI_KEY=
CHAT_AI_BASE_URL=https://api.siliconflow.cn/v1
CHAT_AI_MODEL=deepseek-ai/Deepseek-V4-Flash
# Multiple sources (JSON array, overrides single source above)
# CHAT_AI_SOURCES=[{"name":"siliconflow","key":"sk-...","base_url":"https://api.siliconflow.cn/v1","model":"deepseek-ai/Deepseek-V4-Flash"},{"name":"openai","key":"sk-...","base_url":"https://api.openai.com/v1","model":"gpt-4o"}]
