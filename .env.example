CHAT_JWT_SECRET=change-me-to-a-random-secret
CHAT_ACCESS_TTL=30m
CHAT_REFRESH_TTL=8760h
CHAT_ADDR=:8080
CHAT_DB_PATH=chat.db
CHAT_STATIC_DIR=client/dist
CHAT_BASE_URL=
CHAT_UPLOAD_DIR=uploads
CHAT_UPLOAD_PUBLIC_URL=

# AI
CHAT_AI_KEY=
CHAT_AI_BASE_URL=https://api.siliconflow.cn/v1
CHAT_AI_MODEL=deepseek-ai/Deepseek-V4-Flash
# CHAT_AI_SOURCES=[{"name":"siliconflow","key":"sk-...","base_url":"...","model":"..."}]

# Timeouts
CHAT_API_TIMEOUT=10s
CHAT_UPLOAD_TIMEOUT=5m
CHAT_READ_TIMEOUT=10m
CHAT_READ_HEADER_TIMEOUT=10s

# Limits
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_WS_MAX_MSG_SIZE=65536
